<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Telemetry.init starts Sentry with the app's DSN. Without this the
             Sentry SDK also starts itself from its ContentProvider, finds no DSN
             in the manifest and logs an error on every launch. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
    </application>
</manifest>
